# Decentralize Money Manager - Environment Configuration Template
# Salin file ini menjadi .env atau gunakan .env.peer1 / .env.peer2

# Lokasi penyimpanan database & identitas node P2P (Desktop Tauri)
# Default jika tidak diatur: %APPDATA%\com.dmm.finance (Windows)
DMM_DATA_DIR=./.data-peer1

# ============================================================================
# Konfigurasi Mode WebApp (PWA) — Signaling & STUN/TURN Relay Server
# ============================================================================

# URL WebSocket Signaling Server (Zero-Knowledge / Ephemeral)
# Kosongkan saat development lokal untuk otomatis menggunakan endpoint Vite (`ws://localhost:1420/__dmm_signal`)
# atau isi dengan URL Cloudflare Worker / VPS Anda saat produksi:
# VITE_SIGNALING_URL=wss://dmm-webrtc-signaling.your-subdomain.workers.dev

# Daftar STUN Server (dipisahkan koma). Default menggunakan Google & Cloudflare Public STUN:
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478

# Konfigurasi TURN Relay Server (Opsional tapi sangat disarankan untuk menembus CGNAT 4G/5G & Firewall ketat)
# Opsi Gratis 50 GB/bulan: Daftar di https://www.metered.ca/stun-turn atau gunakan coturn VPS sendiri
# VITE_TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
# VITE_TURN_USERNAME=your_metered_username
# VITE_TURN_CREDENTIAL=your_metered_password


