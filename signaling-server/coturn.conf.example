# ============================================================================
# Contoh Konfigurasi Self-Hosted TURN Server (coturn) untuk P2P Money Manager
# Lokasi file di VPS Ubuntu/Debian: /etc/turnserver.conf
# ============================================================================

# Port standar STUN/TURN (UDP & TCP) dan TURNS (TLS)
listening-port=3478
tls-listening-port=5349

# Ganti dengan IP publik VPS Anda:
# external-ip=203.0.113.10

# Realm dan autentikasi kredensial statis / dinamis
fingerprint
lt-cred-mech
realm=sync.yourdomain.com

# Opsi 1: Username & Password statis (cocok untuk penggunaan pribadi / tim kecil)
# Format: user=username:password
user=dmmuser:GantiDenganPasswordKuat123!

# Opsi 2: Shared Secret (REST API ephemeral credentials)
# use-auth-secret
# static-auth-secret=GANTI_DENGAN_RAHASIA_32_BYTE_HEX

# Batas kuota dan keamanan untuk mencegah penyalahgunaan relay
total-quota=100
max-bps=3000000
stale-nonce=600
no-loopback-peers
no-multicast-peers
no-cli

# Blokir akses relay ke jaringan privat lokal VPS (keamanan wajib)
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255

