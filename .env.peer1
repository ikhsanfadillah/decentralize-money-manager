# Decentralize Money Manager - Environment Configuration
# Lokasi folder data aplikasi.
# Jika dikosongkan/tidak diatur, akan menggunakan folder default OS (%APPDATA%\com.dmm.finance pada Windows)
# Mendukung path relatif (misal: ./.data-peer1) atau absolut (misal: C:\temp\dmm-peer1)
DMM_DATA_DIR=./.data-peer1
DMM_P2P_PORT=11204

